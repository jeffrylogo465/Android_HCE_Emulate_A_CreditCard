<resources>
    <string name="app_name">Shadow Wallet</string>

    <string name="header_write">This app emulates a Credit Card</string>
    <!-- updated: the app clones any card now, not just Visa -->
    <string name="description_write">Clones a real contactless card: read it once with READ CARD, then this app answers the terminal in its place. Registered for the PPSE (2PAY.SYS.DDF01) AID plus the major card schemes.</string>

    <!-- used by apduservice.xml if you switch it from literals to string refs -->
    <string name="servicedesc">HCE Service CreditCard</string>
    <string name="aiddescription">HCE AID Description</string>

    <!-- select PPSE 2PAY.SYS.DDF01 -->
    <string name="hcePpse">325041592E5359532E4444463031</string>
    <!-- visa credit or debit card -->
    <string name="aidVisaCard">A0000000031010</string>
    <!-- mastercard credit or debit card -->
    <string name="aidMastercard">A0000000041010</string>
    <!-- discover / diners -->
    <string name="aidDiscover">A0000001523010</string>

    <string name="hce_service_log">HCE Service Log</string>
</resources>
