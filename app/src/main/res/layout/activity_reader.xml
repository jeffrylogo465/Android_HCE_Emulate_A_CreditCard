<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read Card"
            android:textColor="#F3F4F6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.1"
            android:text="HOLD YOUR CARD FLAT AGAINST THE BACK OF THE PHONE"
            android:textColor="#4B5563"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/txtReaderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Waiting for card..."
            android:textColor="#7C3AED"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:background="#1B1F27" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.1"
            android:text="PAN"
            android:textColor="#6B7280"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtReaderPan"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/field_bg"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="--"
            android:textColor="#E5E7EB"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="EXPIRY"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtReaderExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
