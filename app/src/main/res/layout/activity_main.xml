<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= PAGE 1 · WALLET ================= -->

        <ScrollView
            android:id="@+id/pageWallet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- persistent payment-role prompt, gone while we are the default -->
                <TextView
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/field_bg"
                    android:padding="12dp"
                    android:text="@string/become_default"
                    android:textColor="#F3F4F6"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Cards"
                        android:textColor="#F3F4F6"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 card"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.12"
                    android:text="SWIPE TO SWITCH · TAP EDIT TO CHANGE ONE"
                    android:textColor="#4B5563"
                    android:textSize="9sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pager"
                    android:layout_width="match_parent"
                    android:layout_height="188dp"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="42dp"
                    android:paddingEnd="42dp"
                    android:scrollbars="none" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#1B1F27" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAdd"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1F2430"
                        android:text="ADD CARD"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnClone"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#0F766E"
                        android:text="READ CARD"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCallBank"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1F2430"
                    android:text="CALL ISSUER / CHECK IF LIVE"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= PAGE 2 · EDIT ================= -->

        <ScrollView
            android:id="@+id/pageEdit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Edit card"
                    android:textColor="#F3F4F6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="LABEL"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etLabel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="e.g. AMEX"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="NAME (cardholder, on the slip)"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="SURNAME/FIRSTNAME"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:maxLength="26"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="PAN"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etPan"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="5108050230091071"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="EXPIRY"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="2605"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="SERVICE CODE"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etService"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="201"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="DISCRETIONARY"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etDiscretionary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="230300"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="TRACK 2 RAW HEX (long-press to preview)"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etTrack2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="optional"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="AID (long-press to pick)"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etAid"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="A0000000041010"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="AIP"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etAip"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="3080"
                            android:inputType="textNoSuggestions|textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="AFL (empty = auto)"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etAfl"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="auto from records"
                            android:inputType="textNoSuggestions|textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="CID (computed)"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etCid"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="80"
                            android:inputType="textNoSuggestions|textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="ATC"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etAtc"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="001B"
                            android:inputType="textNoSuggestions|textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="ARQC / 9F26 (computed)"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etArqc"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="optional"
                            android:inputType="textNoSuggestions|textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="IAD / 9F10"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etIad"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/field_bg"
                            android:fontFamily="monospace"
                            android:hint="optional"
                            android:inputType="textNoSuggestions|textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#E5E7EB"
                            android:textColorHint="#4B5563"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/etCvmlist"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="CVM LIST 8E (empty = default)"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etCvmres"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="CVM RESULT 9F34"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etPdol"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="PDOL"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCdol1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="CDOL1"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCdol2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="CDOL2 (must end 9F3403)"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="ISSUER MASTER KEY MK-AC"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etMkac"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="16 bytes hex, optional"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="MSD (0 = EMV, 1 = magstripe)"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etMsd"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:hint="0"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.1"
                    android:text="SCRIPT (match=response, one per line)"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field_bg"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="80A80000=770E8202180094080801010010010300 9000"
                    android:imeOptions="flagNoEnterAction"
                    android:inputType="textMultiLine|textNoSuggestions|textCapCharacters"
                    android:maxLines="12"
                    android:minLines="3"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="vertical"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#4B5563"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:backgroundTint="#4F46E5"
                        android:text="SAVE CARD"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDelete"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#7F1D1D"
                        android:text="DELETE"
                        android:textColor="#FCA5A5"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

